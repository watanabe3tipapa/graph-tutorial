# e-Stat API のアプリケーションID
# https://www.e-stat.go.jp/api/ から発行した値を設定する
ESTAT_APP_ID=

# GitHub API トークン（スター数・更新日を最新化）
# https://github.com/settings/tokens から発行（public_repo の読み取り権限で十分）
GITHUB_TOKEN=

# Cloudflare Kitesurf（Browser Run REST API）用の認証情報
# CF_ACCOUNT_ID: Cloudflare ダッシュボードの Account ID
# CF_TOKEN:     API トークン（権限: Browser Rendering - Edit）
#   https://dash.cloudflare.com/profile/api-tokens から「Create Custom Token」で発行
# 設定すると server/collectors/kitesurf-snapshot が有効になる（未設定ならスキップ）
CF_ACCOUNT_ID=
CF_TOKEN=

# 1 で起動時の自動収集・スケジューラを無効化
COLLECTOR_DISABLED=

# 管理 API（GET /api/collectors / POST /api/collect/:id）のリモート認証トークン
# 未設定の間は、管理 API はループバック（ローカル）からのみ利用できる（fail closed）
# リモートから実行する場合のみ設定し、クライアントは x-admin-token ヘッダで送る
# COLLECTOR_ADMIN_TOKEN=

# 1 で X-Forwarded-For を信頼する（リバースプロキシ配下で管理 API の IP 判定に使用）
# TRUST_PROXY=

# 収集失敗通知（ウェブフック URL。Slack / Teams / GitHub Actions 等の汎用ウェブフック）
# 未設定の間は通知は送信されない
# FAILURE_WEBHOOK_URL=
# 同一コレクタからの通知クールダウン（分）。既定 360（6時間）
# FAILURE_NOTIFY_INTERVAL_MINUTES=360
