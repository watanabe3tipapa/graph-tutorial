{
  "name": "graph-tutorial",
  "version": "0.2.0",
  "private": true,
  "description": "EBPM 関連 OSS と日本の総人口データを可視化するエビデンス・パイプラインのチュートリアル",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "node server/bin/www",
    "lint": "npm run lint -w client",
    "format": "npm run format -w client",
    "test": "npm run test -w client",
    "collect": "npm run collect -w server",
    "collect:list": "npm run collect:list -w server",
    "collect:repos": "npm run collect:repos -w server",
    "collect:population": "npm run collect:population -w server",
    "smoke": "npm run smoke -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
